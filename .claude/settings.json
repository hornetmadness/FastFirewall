{
  "permissions": {
    "allow": [
      "WebFetch(domain:codeberg.org)",
      "Bash(uv sync *)",
      "Bash(python -m pip show pyinfra)",
      "Bash(find / -path \"*/pyinfra/py.typed\")",
      "Bash(find / -path \"*/pyinfra/*.pyi\")",
      "Edit(plugins/*/test_*.py)",
      "Edit(tests/**)",
      "Bash(git pull *)",
      "Bash(git checkout *)",
      "Bash(git -C /home/emathis/FastFirewall branch -a)",
      "Bash(git -C /home/emathis/FastFirewall status)",
      "Bash(git -C /home/emathis/FastFirewall diff --stat HEAD)",
      "Bash(git add *)",
      "Bash(git stash *)",
      "WebFetch(domain:wiki.nftables.org)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f; echo \"$f\" | grep -q '\\.py$' && uv run --with pyright pyright \"$f\"; } 2>/dev/null || true",
            "statusMessage": "Running pyright..."
          }
        ]
      }
    ]
  }
}
